{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"instrument_serif_a8c2eac4-module__ZlIz2q__variable inter_1289ada2-module__rpEG6W__variable antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e41d5df559864f9e-s.p.1g73gv09-xcb6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/13ps_anlmrtg9.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3l04zcqx63h3y.js\"/><script src=\"/_next/static/chunks/2y4wans9ulj_u.js\" async=\"\"></script><script src=\"/_next/static/chunks/08ttfj81-47mu.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-1m14ias-r6ul9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/2drf02ta3e3g9.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><meta name=\"theme-color\" content=\"#0a0a0b\"/><meta name=\"color-scheme\" content=\"dark\"/><title>Adam Mirmina</title><meta name=\"description\" content=\"I build software for problems I can point at, usually because someone I know had one. Data science and cognitive science at Purdue, cardiovascular imaging research, and Ramsgate Studio.\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://adammirmina.com\"/><meta property=\"og:title\" content=\"Adam Mirmina\"/><meta property=\"og:description\" content=\"I build software for problems I can point at, usually because someone I know had one.\"/><meta property=\"og:url\" content=\"https://adammirmina.com\"/><meta property=\"og:site_name\" content=\"Adam Mirmina\"/><meta property=\"og:image\" content=\"https://adammirmina.com/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Adam Mirmina\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Adam Mirmina\"/><meta name=\"twitter:description\" content=\"I build software for problems I can point at, usually because someone I know had one.\"/><meta name=\"twitter:image\" content=\"https://adammirmina.com/og.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed inset-x-0 top-0 z-50 transition-[opacity,transform] duration-500 -translate-y-full opacity-0\"><div class=\"border-b border-rule bg-ground/80 backdrop-blur-md\"><nav class=\"mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4\"><a href=\"#top\" class=\"font-display text-lg leading-none\">Adam Mirmina</a><ul class=\"hidden gap-7 sm:flex\"><li><a href=\"#work\" class=\"border-b pb-0.5 text-sm transition-colors border-transparent text-ink-dim hover:text-ink\">Work</a></li><li><a href=\"#research\" class=\"border-b pb-0.5 text-sm transition-colors border-transparent text-ink-dim hover:text-ink\">Research</a></li><li><a href=\"#studio\" class=\"border-b pb-0.5 text-sm transition-colors border-transparent text-ink-dim hover:text-ink\">Studio</a></li><li><a href=\"#music\" class=\"border-b pb-0.5 text-sm transition-colors border-transparent text-ink-dim hover:text-ink\">Music</a></li><li><a href=\"#contact\" class=\"border-b pb-0.5 text-sm transition-colors border-transparent text-ink-dim hover:text-ink\">Contact</a></li></ul><a href=\"mailto:amirmina@purdue.edu\" class=\"text-sm text-ink-dim transition-colors hover:text-ink sm:hidden\">Email</a></nav></div></header><main id=\"top\"><section class=\"relative mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-center px-6 pb-24 pt-32\"><div class=\"grid items-end gap-12 lg:grid-cols-[1.35fr_1fr]\"><div><div data-reveal=\"true\" class=\"\"><p class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint\">Data science and cognitive science at Purdue</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:60ms\"><h1 class=\"font-display leading-[0.92] tracking-tight [font-size:clamp(3.25rem,11vw,8.5rem)]\">Adam<br/>Mirmina</h1></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><p class=\"mt-10 max-w-xl text-lg leading-relaxed text-ink-dim sm:text-xl\">I build software for problems I can point at, usually because someone I know had one.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:200ms\"><div class=\"mt-10 flex flex-wrap gap-6\"><a href=\"https://github.com/AdamMirmina\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">GitHub</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a><a href=\"https://linkedin.com/in/adam-mirmina\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">LinkedIn</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a><a href=\"https://ramsgatestudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">Ramsgate Studio</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a></div></div></div><div data-reveal=\"true\" class=\"hidden lg:block\" style=\"transition-delay:120ms\"><figure class=\"relative overflow-hidden rounded-sm bg-raise \" style=\"aspect-ratio:4 / 5\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->4<!-- -->:<!-- -->5</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">A portrait. Not a studio headshot; somewhere with real light.</span></figcaption></figure></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:280ms\"><a href=\"#now\" class=\"mt-20 inline-flex items-center gap-3 text-xs uppercase tracking-[0.18em] text-ink-faint transition-colors hover:text-ink-dim\"><span class=\"h-px w-10 bg-ink-faint\" aria-hidden=\"true\"></span>Start here</a></div></section><section id=\"now\" class=\"scroll-mt-24 rule py-20 sm:py-24\"><div class=\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\"><div class=\"lg:sticky lg:top-28 lg:self-start\"><h2 class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\">Now</h2></div><div class=\"min-w-0\"><dl class=\"grid gap-10 sm:grid-cols-3\"><div data-reveal=\"true\" class=\"\"><dt class=\"mb-3 text-xs uppercase tracking-[0.18em] text-ink-faint\">Studying</dt><dd class=\"text-base leading-relaxed text-ink-dim\">B.S. Data Science and B.A. Cognitive Science at Purdue, statistics concentration. Class of 2029.</dd></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:70ms\"><dt class=\"mb-3 text-xs uppercase tracking-[0.18em] text-ink-faint\">Researching</dt><dd class=\"text-base leading-relaxed text-ink-dim\">Cardiovascular Imaging Research Lab under Dr. Craig Goergen, measuring aortic disease from ultrasound.</dd></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><dt class=\"mb-3 text-xs uppercase tracking-[0.18em] text-ink-faint\">Running</dt><dd class=\"text-base leading-relaxed text-ink-dim\">Ramsgate Studio, a web design studio in South Jersey building and hosting sites for small businesses.</dd></div></dl></div></div></section><section id=\"work\" class=\"scroll-mt-24 rule py-20 sm:py-28\"><div class=\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\"><div class=\"lg:sticky lg:top-28 lg:self-start\"><h2 class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\">Work</h2></div><div class=\"min-w-0\"><div class=\"space-y-24 sm:space-y-32\"><article><div data-reveal=\"true\" class=\"\"><figure class=\"relative overflow-hidden rounded-sm bg-raise \" style=\"aspect-ratio:16 / 10\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->16<!-- -->:<!-- -->10</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">The camera rig over the pool, or a frame from the footage with the hoop in view. A real shot in progress beats a clean empty pool.</span></figcaption></figure></div><div class=\"mt-10 grid gap-x-12 gap-y-8 lg:grid-cols-[1fr_1fr]\"><div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:40ms\"><div class=\"mb-5 flex items-baseline gap-4\"><h3 class=\"font-display text-4xl leading-none sm:text-5xl\">PoolVision</h3><span class=\"text-xs uppercase tracking-[0.18em] text-ink-faint\">Computer vision<!-- --> · <!-- -->2026</span></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:80ms\"><p class=\"max-w-md text-xl leading-snug sm:text-2xl\">I run a summer pool-basketball league with my friends, and every score was being typed in by hand.</p></div></div><div class=\"space-y-8\"><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><p class=\"text-base leading-relaxed text-ink-dim\">One fixed camera watches the pool. The pipeline finds each shot, calls it a make or a miss, and is learning to say who took it. Identity comes from coloured swim caps, because people who are wet and half-submerged thirty feet away carry none of the cues a face model needs.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><dl class=\"flex flex-wrap gap-x-10 gap-y-5\"><div class=\"max-w-[13rem]\"><dt class=\"font-display text-3xl leading-none\">82.2%</dt><dd class=\"mt-2 text-sm leading-snug text-ink-dim\">on shots it never saw in training</dd></div><div class=\"max-w-[13rem]\"><dt class=\"font-display text-3xl leading-none\">146</dt><dd class=\"mt-2 text-sm leading-snug text-ink-dim\">shots judged by hand to train it</dd></div><div class=\"max-w-[13rem]\"><dt class=\"font-display text-3xl leading-none\">118 min</dt><dd class=\"mt-2 text-sm leading-snug text-ink-dim\">of 4K footage recorded and labelled</dd></div></dl></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:180ms\"><div class=\"flex flex-wrap items-center justify-between gap-4\"><p class=\"text-xs uppercase tracking-[0.14em] text-ink-faint\">Python  ·  PyTorch  ·  YOLO11  ·  OpenCV</p><a href=\"https://github.com/AdamMirmina/poolvision\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">See it</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a></div></div></div></div><div class=\"rule mt-24 sm:mt-32\" aria-hidden=\"true\"></div></article><article><div data-reveal=\"true\" class=\"\"><figure class=\"relative overflow-hidden rounded-sm bg-raise \" style=\"aspect-ratio:16 / 10\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->16<!-- -->:<!-- -->10</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">Two phone screens side by side: a workout mid-session, and the coach mid-conversation with a citation visible.</span></figcaption></figure></div><div class=\"mt-10 grid gap-x-12 gap-y-8 lg:grid-cols-[1fr_1fr]\"><div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:40ms\"><div class=\"mb-5 flex items-baseline gap-4\"><h3 class=\"font-display text-4xl leading-none sm:text-5xl\">Bro Science</h3><span class=\"text-xs uppercase tracking-[0.18em] text-ink-faint\">iOS app<!-- --> · <!-- -->2026</span></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:80ms\"><p class=\"max-w-md text-xl leading-snug sm:text-2xl\">I lift, and I wanted a coach that would tell me when it did not know.</p></div></div><div class=\"space-y-8\"><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><p class=\"text-base leading-relaxed text-ink-dim\">A training app with an AI coach that reads your actual routine and history before it proposes anything. It cites the study behind each change, only where a study really tested that exercise, and says when none has rather than inventing one. It works with no signal and reconciles when it reconnects.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><dl class=\"flex flex-wrap gap-x-10 gap-y-5\"><div class=\"max-w-[13rem]\"><dt class=\"font-display text-3xl leading-none\">5</dt><dd class=\"mt-2 text-sm leading-snug text-ink-dim\">people logging their training in it</dd></div><div class=\"max-w-[13rem]\"><dt class=\"font-display text-3xl leading-none\">19</dt><dd class=\"mt-2 text-sm leading-snug text-ink-dim\">entity types reconciled offline-first</dd></div></dl></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:180ms\"><div class=\"flex flex-wrap items-center justify-between gap-4\"><p class=\"text-xs uppercase tracking-[0.14em] text-ink-faint\">React Native  ·  Expo  ·  SQLite  ·  PocketBase  ·  Anthropic API</p></div></div></div></div><div class=\"rule mt-24 sm:mt-32\" aria-hidden=\"true\"></div></article><article><div data-reveal=\"true\" class=\"\"><figure class=\"relative overflow-hidden rounded-sm bg-raise \" style=\"aspect-ratio:16 / 10\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->16<!-- -->:<!-- -->10</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">The capture screen with several notes already mapped to colours. Colour is the whole subject, so let it fill the frame.</span></figcaption></figure></div><div class=\"mt-10 grid gap-x-12 gap-y-8 lg:grid-cols-[1fr_1fr]\"><div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:40ms\"><div class=\"mb-5 flex items-baseline gap-4\"><h3 class=\"font-display text-4xl leading-none sm:text-5xl\">Spectra</h3><span class=\"text-xs uppercase tracking-[0.18em] text-ink-faint\">Web app<!-- --> · <!-- -->2026</span></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:80ms\"><p class=\"max-w-md text-xl leading-snug sm:text-2xl\">My partner has chromesthesia. She sees colour when she hears music, and had no way to write any of it down.</p></div></div><div class=\"space-y-8\"><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><p class=\"text-base leading-relaxed text-ink-dim\">A tool for recording what a note or a chord actually looks like to her, with microphone chord recognition so capture keeps up with playing. The point was never the visualisation, it was the data: a record that survives the device it was entered on.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><dl class=\"flex flex-wrap gap-x-10 gap-y-5\"><div class=\"max-w-[13rem]\"><dt class=\"font-display text-3xl leading-none\">1</dt><dd class=\"mt-2 text-sm leading-snug text-ink-dim\">person it was built for</dd></div></dl></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:180ms\"><div class=\"flex flex-wrap items-center justify-between gap-4\"><p class=\"text-xs uppercase tracking-[0.14em] text-ink-faint\">Vite  ·  React  ·  Cloudflare Workers  ·  PocketBase</p></div></div></div></div><div class=\"rule mt-24 sm:mt-32\" aria-hidden=\"true\"></div></article><article><div data-reveal=\"true\" class=\"\"><figure class=\"relative overflow-hidden rounded-sm bg-raise \" style=\"aspect-ratio:16 / 10\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->16<!-- -->:<!-- -->10</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">A game in progress on a laptop, board mid-game with a rack visible.</span></figcaption></figure></div><div class=\"mt-10 grid gap-x-12 gap-y-8 lg:grid-cols-[1fr_1fr]\"><div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:40ms\"><div class=\"mb-5 flex items-baseline gap-4\"><h3 class=\"font-display text-4xl leading-none sm:text-5xl\">Mirmina Tiles</h3><span class=\"text-xs uppercase tracking-[0.18em] text-ink-faint\">Real-time game<!-- --> · <!-- -->2026</span></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:80ms\"><p class=\"max-w-md text-xl leading-snug sm:text-2xl\">My family plays word games, and we are spread across three states.</p></div></div><div class=\"space-y-8\"><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><p class=\"text-base leading-relaxed text-ink-dim\">Scrabble rules, played in a browser, in real time. The server owns every move: it validates the board, keeps each player&#x27;s rack private, and settles who played what. Doing that on the client would mean trusting five relatives not to read each other&#x27;s letters.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><dl class=\"flex flex-wrap gap-x-10 gap-y-5\"><div class=\"max-w-[13rem]\"><dt class=\"font-display text-3xl leading-none\">Server</dt><dd class=\"mt-2 text-sm leading-snug text-ink-dim\">authoritative on every move</dd></div></dl></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:180ms\"><div class=\"flex flex-wrap items-center justify-between gap-4\"><p class=\"text-xs uppercase tracking-[0.14em] text-ink-faint\">Vite  ·  React  ·  Cloudflare Workers  ·  PocketBase</p><a href=\"https://mirminatiles.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">See it</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a></div></div></div></div></article></div><div class=\"rule mt-24 pt-12 sm:mt-32\"><h3 class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint\">Also built</h3><ul class=\"grid gap-x-12 gap-y-6 sm:grid-cols-2\"><div data-reveal=\"true\" class=\"\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Cashbook</span><span class=\"text-sm leading-relaxed text-ink-dim\">A ledger that reconciles four sources into one book and files itself.</span></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:40ms\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Drop</span><span class=\"text-sm leading-relaxed text-ink-dim\">Moves a file between my phone and my computer without going through email.</span></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:80ms\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Roots</span><span class=\"text-sm leading-relaxed text-ink-dim\">A private family tree, built because the commercial ones want your data.</span></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:120ms\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Semester</span><span class=\"text-sm leading-relaxed text-ink-dim\">A coursework planner that replaced a spreadsheet I maintained by hand.</span></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:160ms\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Share</span><span class=\"text-sm leading-relaxed text-ink-dim\">Turns a markdown file into a page worth sending someone.</span></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:200ms\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Mesh</span><span class=\"text-sm leading-relaxed text-ink-dim\">Group scheduling with no accounts. Share a link, mark when you are free.</span></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:240ms\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Birthday Bird</span><span class=\"text-sm leading-relaxed text-ink-dim\">Add a birthday, get reminded. Nothing else.</span></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:280ms\"><li class=\"flex gap-4\"><span class=\"min-w-[7.5rem] font-display text-lg leading-snug\">Corridor</span><span class=\"text-sm leading-relaxed text-ink-dim\">Leadership turnover across 101 Philadelphia development corporations.</span></li></div></ul></div></div></div></section><section id=\"research\" class=\"scroll-mt-24 rule py-20 sm:py-28\"><div class=\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\"><div class=\"lg:sticky lg:top-28 lg:self-start\"><h2 class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\">Research</h2></div><div class=\"min-w-0\"><div data-reveal=\"true\" class=\"\"><h3 class=\"font-display text-4xl leading-tight sm:text-5xl\">Measuring aortic disease from ultrasound</h3></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:60ms\"><p class=\"mt-5 text-sm text-ink-faint\">Cardiovascular Imaging Research Laboratory, Purdue<!-- --> · <!-- -->December 2025 to present<br/>Principal Investigator <!-- -->Dr. Craig Goergen<!-- -->. Supervised by <!-- -->Shubh Mehta, American Heart Association Predoctoral Fellow<!-- -->.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><p class=\"mt-10 max-w-2xl text-lg leading-relaxed text-ink-dim\">The lab studies aortopathy, where the aortic root widens and its wall weakens on the way to an aneurysm. Two numbers track it: how wide the root is, and how much it expands with each heartbeat. The second falls as the wall stiffens, which makes measurement error dangerous in one direction. A tool that overstates movement makes a diseased vessel look healthy, and it does that most on exactly the clips where measuring is hardest.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><figure class=\"relative overflow-hidden rounded-sm bg-raise mt-12\" style=\"aspect-ratio:16 / 10\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->16<!-- -->:<!-- -->10</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">An ultrasound frame with a traced contour on it, or the MATLAB tool mid-measurement. Check with the lab before publishing any real subject data.</span></figcaption></figure></div><div class=\"mt-14 space-y-10\"><div data-reveal=\"true\" class=\"\"><div class=\"grid gap-3 lg:grid-cols-[1fr_1fr] lg:gap-12\"><h4 class=\"text-xl leading-snug\">Built a detector that measures the aortic root from ultrasound video</h4><p class=\"text-base leading-relaxed text-ink-dim\">It reads each frame on its own instead of tracking motion between frames, so it cannot accumulate drift. It agrees with hand-traced measurements within 3% on two animals, and refuses to report at all below 80% frame coverage rather than returning a number nobody could tell was wrong.</p></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:60ms\"><div class=\"grid gap-3 lg:grid-cols-[1fr_1fr] lg:gap-12\"><h4 class=\"text-xl leading-snug\">Found the lab&#x27;s existing tracker overstating expansion by two to three times</h4><p class=\"text-base leading-relaxed text-ink-dim\">In the direction that makes a stiffening vessel read as healthy. The cause was accumulated seeding error making the two tracked walls cross, producing negative vessel widths on 49 of 300 frames that had been flowing silently into analysis and export.</p></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:120ms\"><div class=\"grid gap-3 lg:grid-cols-[1fr_1fr] lg:gap-12\"><h4 class=\"text-xl leading-snug\">Diagnosed why one measurement had never been possible</h4><p class=\"text-base leading-relaxed text-ink-dim\">Cyclic strain was not a method problem, it was a sampling problem. The standard scan gives about 8 frames per heartbeat, too few to separate real motion from noise. A scan mode already sitting in the archive gives about 110, and produced a clean heartbeat curve for the first time.</p></div></div></div></div></div></section><section id=\"studio\" class=\"scroll-mt-24 rule py-20 sm:py-28\"><div class=\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\"><div class=\"lg:sticky lg:top-28 lg:self-start\"><h2 class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\">Studio</h2></div><div class=\"min-w-0\"><div class=\"grid gap-12 lg:grid-cols-[1fr_1fr]\"><div><div data-reveal=\"true\" class=\"\"><h3 class=\"font-display text-4xl leading-none sm:text-5xl\">Ramsgate Studio</h3></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:60ms\"><p class=\"mt-4 text-sm text-ink-faint\">May 2026 to present</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><p class=\"mt-8 text-lg leading-relaxed text-ink-dim\">A web design studio in Cherry Hill, New Jersey. Flat fee to build, then a monthly fee to host and look after it. I do the design, the code, and the infrastructure, and I run the client calls.</p></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:140ms\"><div class=\"mt-8\"><a href=\"https://ramsgatestudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">ramsgatestudio.com</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a></div></div></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:80ms\"><figure class=\"relative overflow-hidden rounded-sm bg-raise \" style=\"aspect-ratio:16 / 10\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->16<!-- -->:<!-- -->10</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">A client site on a laptop, or the admin dashboard. Something that shows real work rather than a logo on a wall.</span></figcaption></figure></div></div><ul class=\"mt-14 space-y-6\"><div data-reveal=\"true\" class=\"\"><li class=\"max-w-3xl border-l border-rule pl-6 text-base leading-relaxed text-ink-dim\">Built the whole client platform: intake that saves as you type so an abandoned form still arrives as a lead, contract signing where a change after signing needs the other side to accept it, payments, and a revenue surface that exports the workbook an accountant asked for.</li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:60ms\"><li class=\"max-w-3xl border-l border-rule pl-6 text-base leading-relaxed text-ink-dim\">Migrated it three times while clients were working in it, without downtime. The last one moved builds onto the hosting platform, so a deploy can no longer report success without shipping.</li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:120ms\"><li class=\"max-w-3xl border-l border-rule pl-6 text-base leading-relaxed text-ink-dim\">Delivered client sites including an e-commerce build, where event capacity is enforced on the server so a payment for a seat already gone refunds itself.</li></div></ul></div></div></section><section id=\"music\" class=\"scroll-mt-24 rule py-20 sm:py-28\"><div class=\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\"><div class=\"lg:sticky lg:top-28 lg:self-start\"><h2 class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\">Music</h2></div><div class=\"min-w-0\"><div class=\"grid gap-12 lg:grid-cols-[1fr_1.4fr]\"><div data-reveal=\"true\" class=\"\"><figure class=\"relative overflow-hidden rounded-sm bg-raise \" style=\"aspect-ratio:4 / 5\"><figcaption class=\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\"><span class=\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\">Photo · <!-- -->4<!-- -->:<!-- -->5</span><span class=\"max-w-md text-sm leading-relaxed text-ink-faint\">Playing. Mid-performance, in uniform or behind a kit. Motion and hands matter more than a posed shot.</span></figcaption></figure></div><div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:60ms\"><p class=\"text-xl leading-relaxed sm:text-2xl\">I have played percussion for most of my life and I teach it. Writing for a drumline is the closest thing I do to engineering that is not engineering: fixed constraints, a fixed number of hands, and it has to survive being played outdoors by teenagers at full tempo.</p></div><dl class=\"mt-12 space-y-8\"><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><dt class=\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\">Wrote the music</dt><dd class=\"text-base leading-relaxed text-ink-dim\">Battery music for all three movements of a field show, a cadence for battery and front ensemble, and six transcriptions. Drumline co-captain in 2023.</dd></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:160ms\"><dt class=\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\">Teach it</dt><dd class=\"text-base leading-relaxed text-ink-dim\">Private instruction in drum set, drumline, and non-melodic percussion through Mirmina Music. In the first seven months, every student with no marching experience earned the placement they auditioned for.</dd></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:220ms\"><dt class=\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\">Still play</dt><dd class=\"text-base leading-relaxed text-ink-dim\">Purdue Varsity Band as a concert percussionist and soloist, and snare with the Boiler Beats drumline. Before that, jazz ensemble rated outstanding by every adjudicator at the Pennsbury jazz festival.</dd></div></dl></div></div><div class=\"rule mt-20 pt-12\"><ul class=\"grid gap-8 sm:grid-cols-3\"><div data-reveal=\"true\" class=\"\"><li><p class=\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\">Purdue Lunabotics</p><p class=\"text-sm leading-relaxed text-ink-dim\">Software team on an autonomous lunar excavation robot for NASA&#x27;s competition, working on the perception stack.</p></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:50ms\"><li><p class=\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\">Salsa Club</p><p class=\"text-sm leading-relaxed text-ink-dim\">Purdue Salsa Club, 2025 to present.</p></li></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:100ms\"><li><p class=\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\">Longboarding Club</p><p class=\"text-sm leading-relaxed text-ink-dim\">Purdue Longboarding Club, 2025 to present.</p></li></div></ul></div></div></div></section><section id=\"contact\" class=\"scroll-mt-24 rule py-20 sm:py-28\"><div class=\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\"><div class=\"lg:sticky lg:top-28 lg:self-start\"><h2 class=\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\">Contact</h2></div><div class=\"min-w-0\"><div data-reveal=\"true\" class=\"\"><a href=\"mailto:amirmina@purdue.edu\" class=\"font-display leading-none tracking-tight transition-colors hover:text-ink-dim [font-size:clamp(2rem,6vw,4.5rem)]\">amirmina@purdue.edu</a></div><div data-reveal=\"true\" class=\"\" style=\"transition-delay:80ms\"><div class=\"mt-12 flex flex-wrap gap-8\"><a href=\"https://github.com/AdamMirmina\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">GitHub</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a><a href=\"https://linkedin.com/in/adam-mirmina\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">LinkedIn</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a><a href=\"https://ramsgatestudio.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\"><span class=\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\">Ramsgate Studio</span><span aria-hidden=\"true\" class=\"translate-y-px text-xs\">↗</span></a></div></div></div></div></section><footer class=\"mx-auto max-w-6xl px-6 py-12\"><p class=\"text-xs text-ink-faint\">Built and hosted by me. West Lafayette, Indiana and Cherry Hill, New Jersey.</p></footer></main><!--$--><!--/$--><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"Adam Mirmina\",\"url\":\"https://adammirmina.com\",\"email\":\"mailto:amirmina@purdue.edu\",\"jobTitle\":\"Founder and Engineer\",\"affiliation\":[{\"@type\":\"CollegeOrUniversity\",\"name\":\"Purdue University\"},{\"@type\":\"Organization\",\"name\":\"Ramsgate Studio\",\"url\":\"https://ramsgatestudio.com\"}],\"sameAs\":[\"https://github.com/AdamMirmina\",\"https://linkedin.com/in/adam-mirmina\"]}</script><script src=\"/_next/static/chunks/3l04zcqx63h3y.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n4:I[58562,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2drf02ta3e3g9.js\\\"],\\\"TopBar\\\"]\\n5:I[58562,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2drf02ta3e3g9.js\\\"],\\\"Reveals\\\"]\\n15:I[68027,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/13ps_anlmrtg9.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/e41d5df559864f9e-s.p.1g73gv09-xcb6.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"\\\"