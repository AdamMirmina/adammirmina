me\":\"mt-2 text-sm leading-snug text-ink-dim\",\"children\":\"on shots it never saw in training\"}]]}],[\"$\",\"div\",\"shots judged by hand to train it\",{\"className\":\"max-w-[13rem]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-display text-3xl leading-none\",\"children\":\"146\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-snug text-ink-dim\",\"children\":\"shots judged by hand to train it\"}]]}],[\"$\",\"div\",\"of 4K footage recorded and labelled\",{\"className\":\"max-w-[13rem]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-display text-3xl leading-none\",\"children\":\"118 min\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-snug text-ink-dim\",\"children\":\"of 4K footage recorded and labelled\"}]]}]]}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"180ms\"},\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center justify-between gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs uppercase tracking-[0.14em] text-ink-faint\",\"children\":\"Python  ·  PyTorch  ·  YOLO11  ·  OpenCV\"}],[\"$\",\"a\",null,{\"href\":\"https://github.com/AdamMirmina/poolvision\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\",\"children\":[\"$L17\",\"$L18\"]}]]}]}]]}]]}],\"$L19\"]}],\"$L1a\",\"$L1b\",\"$L1c\"]}],\"$L1d\"]}]]}]}]\nd:[\"$\",\"section\",null,{\"id\":\"research\",\"className\":\"scroll-mt-24 rule py-20 sm:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"h2\",null,{\"className\":\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\",\"children\":\"Research\"}]}],[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":\"$undefined\",\"children\":[\"$\",\"h3\",null,{\"className\":\"font-display text-4xl leading-tight sm:text-5xl\",\"children\":\"Measuring aortic disease from ultrasound\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"60ms\"},\"children\":[\"$\",\"p\",null,{\"className\":\"mt-5 text-sm text-ink-faint\",\"children\":[\"Cardiovascular Imaging Research Laboratory, Purdue\",\" · \",\"December 2025 to present\",[\"$\",\"br\",null,{}],\"Principal Investigator \",\"Dr. Craig Goergen\",\". Supervised by \",\"Shubh Mehta, American Heart Association Predoctoral Fellow\",\".\"]}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"100ms\"},\"children\":[\"$\",\"p\",null,{\"className\":\"mt-10 max-w-2xl text-lg leading-relaxed text-ink-dim\",\"children\":\"The lab studies aortopathy, where the aortic root widens and its wall weakens on the way to an aneurysm. Two numbers track it: how wide the root is, and how much it expands with each heartbeat. The second falls as the wall stiffens, which makes measurement error dangerous in one direction. A tool that overstates movement makes a diseased vessel look healthy, and it does that most on exactly the clips where measuring is hardest.\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"140ms\"},\"children\":[\"$\",\"figure\",null,{\"className\":\"relative overflow-hidden rounded-sm bg-raise mt-12\",\"style\":{\"aspectRatio\":\"16 / 10\"},\"children\":[\"$\",\"figcaption\",null,{\"className\":\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\",\"children\":[\"Photo · \",16,\":\",10]}],[\"$\",\"span\",null,{\"className\":\"max-w-md text-sm leading-relaxed text-ink-faint\",\"children\":\"An ultrasound frame with a traced contour on it, or the MATLAB tool mid-measurement. Check with the lab before publishing any real subject data.\"}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"mt-14 space-y-10\",\"children\":[[\"$\",\"div\",\"Built a detector that measures the aortic root from ultrasound video\",{\"data-reveal\":true,\"className\":\"\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-3 lg:grid-cols-[1fr_1fr] lg:gap-12\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"text-xl leading-snug\",\"children\":\"Built a detector that measures the aortic root from ultrasound video\"}],[\"$\",\"p\",null,{\"className\":\"text-base leading-relaxed text-ink-dim\",\"children\":\"It reads each frame on its own instead of tracking motion between frames, so it cannot accumulate drift. It agrees with hand-traced measurements within 3% on two animals, and refuses to report at all below 80% frame coverage rather than returning a number nobody could tell was wrong.\"}]]}]}],[\"$\",\"div\",\"Found the lab's existing tracker overstating expansion by two to three times\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"60ms\"},\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-3 lg:grid-cols-[1fr_1fr] lg:gap-12\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"text-xl leading-snug\",\"children\":\"Found the lab's existing tracker overstating expansion by two to three times\"}],[\"$\",\"p\",null,{\"className\":\"text-base leading-relaxed text-ink-dim\",\"children\":\"In the direction that makes a stiffening vessel read as healthy. The cause was accumulated seeding error making the two tracked walls cross, producing negative vessel widths on 49 of 300 frames that had been flowing silently into analysis and export.\"}]]}]}],\"$L1e\"]}]]}]]}]}]\ne:[\"$\",\"section\",null,{\"id\":\"studio\",\"className\":\"scroll-mt-24 rule py-20 sm:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max