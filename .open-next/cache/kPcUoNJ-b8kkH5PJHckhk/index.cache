{\"transitionDelay\":\"140ms\"},\"children\":[\"$\",\"dl\",null,{\"className\":\"flex flex-wrap gap-x-10 gap-y-5\",\"children\":[[\"$\",\"div\",\"on shots it never saw in training\",{\"className\":\"max-w-[13rem]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-display text-3xl leading-none\",\"children\":\"82.2%\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-snug text-ink-dim\",\"children\":\"on shots it never saw in training\"}]]}],[\"$\",\"div\",\"shots judged by hand to train it\",{\"className\":\"max-w-[13rem]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-display text-3xl leading-none\",\"children\":\"146\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-snug text-ink-dim\",\"children\":\"shots judged by hand to train it\"}]]}],[\"$\",\"div\",\"of 4K footage recorded and labelled\",{\"className\":\"max-w-[13rem]\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-display text-3xl leading-none\",\"children\":\"118 min\"}],[\"$\",\"dd\",null,{\"className\":\"mt-2 text-sm leading-snug text-ink-dim\",\"children\":\"of 4K footage recorded and labelled\"}]]}]]}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"180ms\"},\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center justify-between gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs uppercase tracking-[0.14em] text-ink-faint\",\"children\":\"Python  ·  PyTorch  ·  YOLO11  ·  OpenCV\"}],[\"$\",\"a\",null,{\"href\":\"https://github.com/AdamMirmina/poolvision\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\",\"children\":[\"$L17\",\"$L18\"]}]]}]}]]}]]}],\"$L19\"]}],\"$L1a\",\"$L1b\",\"$L1c\"]}],\"$L1d\"]}]]}]}]\n8:[\"$\",\"section\",null,{\"id\":\"research\",\"className\":\"scroll-mt-24 rule py-20 sm:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"h2\",null,{\"className\":\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\",\"children\":\"Research\"}]}],[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"children\":[\"$\",\"h3\",null,{\"className\":\"font-display text-4xl leading-tight sm:text-5xl\",\"children\":\"Measuring aortic disease from ultrasound\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"60ms\"},\"children\":[\"$\",\"p\",null,{\"className\":\"mt-5 text-sm text-ink-faint\",\"children\":[\"Cardiovascular Imaging Research Laboratory, Purdue\",\" · \",\"December 2025 to present\",[\"$\",\"br\",null,{}],\"Principal Investigator \",\"Dr. Craig Goergen\",\". Supervised by \",\"Shubh Mehta, American Heart Association Predoctoral Fellow\",\".\"]}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"100ms\"},\"children\":[\"$\",\"p\",null,{\"className\":\"mt-10 max-w-2xl text-lg leading-relaxed text-ink-dim\",\"children\":\"The lab studies aortopathy, where the aortic root widens and its wall weakens on the way to an aneurysm. Two numbers track it: how wide the root is, and how much it expands with each heartbeat. The second falls as the wall stiffens, which makes measurement error dangerous in one direction. A tool that overstates movement makes a diseased vessel look healthy, and it does that most on exactly the clips where measuring is hardest.\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"140ms\"},\"children\":[\"$\",\"figure\",null,{\"className\":\"relative overflow-hidden rounded-sm bg-raise mt-12\",\"style\":{\"aspectRatio\":\"16 / 10\"},\"children\":[\"$\",\"figcaption\",null,{\"className\":\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\",\"children\":[\"Photo · \",16,\":\",10]}],[\"$\",\"span\",null,{\"className\":\"max-w-md text-sm leading-relaxed text-ink-faint\",\"children\":\"An ultrasound frame with a traced contour on it, or the MATLAB tool mid-measurement. Check with the lab before publishing any real subject data.\"}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"mt-14 space-y-10\",\"children\":[[\"$\",\"div\",\"Built a detector that measures the aortic root from ultrasound video\",{\"data-reveal\":true,\"className\":\"\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-3 lg:grid-cols-[1fr_1fr] lg:gap-12\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"text-xl leading-snug\",\"children\":\"Built a detector that measures the aortic root from ultrasound video\"}],[\"$\",\"p\",null,{\"className\":\"text-base leading-relaxed text-ink-dim\",\"children\":\"It reads each frame on its own instead of tracking motion between frames, so it cannot accumulate drift. It agrees with hand-traced measurements within 3% on two animals, and refuses to report at all below 80% frame coverage rather than returning a number nobody could tell was wrong.\"}]]}]}],[\"$\",\"div\",\"Found the lab's existing tracker overstating expansion by two to three times\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"60ms\"},\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-3 lg:grid-cols-[1fr_1fr] lg:gap-12\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"text-xl leading-snug\",\"children\":\"Found the lab's existing tracker overstating expansion by two to three times\"}],[\"$\",\"p\",null,{\"className\":\"text-base leading-relaxed text-ink-dim\",\"children\":\"In the direction that makes a stiffening vessel read as healthy. The cause was accumulated seeding error making the two tracked walls cross, producing negative vessel widths on 49 of 300 frames that had been flowing silently into analysis and export.\"}]]}]}],\"$L1e\"]}]]}]]}]}]\n9:[\"$\",\"section\",null,{\"id\":\"studio\",\"className\":\"scroll-mt-24 rule py-20 sm:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"h2\",null,{\"className\":\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\",\"children\":\"Studio\"}]}],[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-12 lg:grid-cols-[1fr_1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"children\":[\"$\",\"h3\",null,{\"className\":\"font-display text-4xl leading-none sm:text-5xl\",\"children\":\"Ramsgate Studio\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"60ms\"},\"children\":[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-ink-faint\",\"children\":\"May 2026 to present\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"100ms\"},\"children\":[\"$\",\"p\",null,{\"className\":\"mt-8 text-lg leading-relaxed text-ink-dim\",\"children\":\"A web design studio in Cherry Hill, New Jersey. Flat fee to build, then a monthly fee to host and look after it. I do the design, the code, and the infrastructure, and I run the client calls.\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"140ms\"},\"children\":[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://ramsgatestudio.com\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"group inline-flex items-baseline gap-1.5 text-sm text-ink transition-colors hover:text-ink-dim\",\"children\":[[\"$\",\"span\",null,{\"className\":\"border-b border-ink-faint pb-px transition-colors group-hover:border-ink-dim\",\"children\":\"ramsgatestudio.com\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"className\":\"translate-y-px text-xs\",\"children\":\"↗\"}]]}]}]}]]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"80ms\"},\"children\":[\"$\",\"figure\",null,{\"className\":\"relative overflow-hidden rounded-sm bg-raise \",\"style\":{\"aspectRatio\":\"16 / 10\"},\"children\":[\"$\",\"figcaption\",null,{\"className\":\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\",\"children\":[\"Photo · \",16,\":\",10]}],[\"$\",\"span\",null,{\"className\":\"max-w-md text-sm leading-relaxed text-ink-faint\",\"children\":\"A client site on a laptop, or the admin dashboard. Something that shows real work rather than a logo on a wall.\"}]]}]}]}]]}],[\"$\",\"ul\",null,{\"className\":\"mt-14 space-y-6\",\"children\":[[\"$\",\"div\",\"0\",{\"data-reveal\":true,\"className\":\"\",\"children\":[\"$\",\"li\",null,{\"className\":\"max-w-3xl border-l border-rule pl-6 text-base leading-relaxed text-ink-dim\",\"children\":\"Built the whole client platform: intake that saves as you type so an abandoned form still arrives as a lead, contract signing where a change after signing needs the other side to accept it, payments, and a revenue surface that exports the workbook an accountant asked for.\"}]}],[\"$\",\"div\",\"1\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"60ms\"},\"children\":[\"$\",\"li\",null,{\"className\":\"max-w-3xl border-l border-rule pl-6 text-base leading-relaxed text-ink-dim\",\"children\":\"Migrated it three times while clients were working in it, without downtime. The last one moved builds onto the hosting platform, so a deploy can no longer report success without shipping.\"}]}],[\"$\",\"div\",\"2\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"120ms\"},\"children\":[\"$\",\"li\",null,{\"className\":\"max-w-3xl border-l border-rule pl-6 text-base leading-relaxed text-ink-dim\",\"children\":\"Delivered client sites including an e-commerce build, where event capacity is enforced on the server so a payment for a seat already gone refunds itself.\"}]}]]}]]}]]}]}]\na:[\"$\",\"section\",null,{\"id\":\"music\",\"className\":\"scroll-mt-24 rule py-20 sm:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"h2\",null,{\"className\":\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\",\"children\":\"Music\"}]}],[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-12 lg:grid-cols-[1fr_1.4fr]\",\"children\":[[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"children\":[\"$\",\"figure\",null,{\"className\":\"relative overflow-hidden rounded-sm bg-raise \",\"style\":{\"aspectRatio\":\"4 / 5\"},\"children\":[\"$\",\"figcaption\",null,{\"className\":\"frame-pending absolute inset-0 flex flex-col justify-end gap-2 border border-rule p-5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[0.65rem] uppercase tracking-[0.18em] text-ink-faint\",\"children\":[\"Photo · \",4,\":\",5]}],[\"$\",\"span\",null,{\"className\":\"max-w-md text-sm leading-relaxed text-ink-faint\",\"children\":\"Playing. Mid-performance, in uniform or behind a kit. Motion and hands matter more than a posed shot.\"}]]}]}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"60ms\"},\"children\":[\"$\",\"p\",null,{\"className\":\"text-xl leading-relaxed sm:text-2xl\",\"children\":\"I have played percussion for most of my life and I teach it. Writing for a drumline is the closest thing I do to engineering that is not engineering: fixed constraints, a fixed number of hands, and it has to survive being played outdoors by teenagers at full tempo.\"}]}],[\"$\",\"dl\",null,{\"className\":\"mt-12 space-y-8\",\"children\":[[\"$\",\"div\",\"Wrote the music\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"100ms\"},\"children\":[[\"$\",\"dt\",null,{\"className\":\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\",\"children\":\"Wrote the music\"}],[\"$\",\"dd\",null,{\"className\":\"text-base leading-relaxed text-ink-dim\",\"children\":\"Battery music for all three movements of a field show, a cadence for battery and front ensemble, and six transcriptions. Drumline co-captain in 2023.\"}]]}],[\"$\",\"div\",\"Teach it\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"160ms\"},\"children\":[[\"$\",\"dt\",null,{\"className\":\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\",\"children\":\"Teach it\"}],[\"$\",\"dd\",null,{\"className\":\"text-base leading-relaxed text-ink-dim\",\"children\":\"Private instruction in drum set, drumline, and non-melodic percussion through Mirmina Music. In the first seven months, every student with no marching experience earned the placement they auditioned for.\"}]]}],[\"$\",\"div\",\"Still play\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"220ms\"},\"children\":[[\"$\",\"dt\",null,{\"className\":\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\",\"children\":\"Still play\"}],[\"$\",\"dd\",null,{\"className\":\"text-base leading-relaxed text-ink-dim\",\"children\":\"Purdue Varsity Band as a concert percussionist and soloist, and snare with the Boiler Beats drumline. Before that, jazz ensemble rated outstanding by every adjudicator at the Pennsbury jazz festival.\"}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rule mt-20 pt-12\",\"children\":[\"$\",\"ul\",null,{\"className\":\"grid gap-8 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",\"Purdue Lunabotics\",{\"data-reveal\":true,\"className\":\"\",\"children\":[\"$\",\"li\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\",\"children\":\"Purdue Lunabotics\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-relaxed text-ink-dim\",\"children\":\"Software team on an autonomous lunar excavation robot for NASA's competition, working on the perception stack.\"}]]}]}],[\"$\",\"div\",\"Salsa Club\",{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"50ms\"},\"children\":[\"$\",\"li\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2 text-xs uppercase tracking-[0.18em] text-ink-faint\",\"children\":\"Salsa Club\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-relaxed text-ink-dim\",\"children\":\"Purdue Salsa Club, 2025 to present.\"}]]}]}],\"$L1f\"]}]}]]}]]}]}]\nb:[\"$\",\"section\",null,{\"id\":\"contact\",\"className\":\"scroll-mt-24 rule py-20 sm:py-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[8rem_1fr] lg:gap-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"h2\",null,{\"className\":\"mb-8 text-xs uppercase tracking-[0.18em] text-ink-faint lg:mb-0\",\"children\":\"Contact\"}]}],[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"children\":[\"$\",\"a\",null,{\"href\":\"mailto:amirmina@purdue.edu\",\"className\":\"font-display leading-none tracking-tight transition-colors hover:text-ink-dim [font-size:clamp(2rem,6vw,4.5rem)]\",\"children\":\"amirmina@purdue.edu\"}]}],[\"$\",\"div\",null,{\"data-reveal\":true,\"className\":\"\",\"style\":{\"transitionDelay\":\"80ms\"},\"children\":[\"$\",\"div\",null,{\"className\":\"mt-12 flex flex-wrap gap-